<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ELearnLanguage" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="colorSurface">@color/app_surface_card</item>
    </style>

    <style name="Theme.ELearnLanguage" parent="Base.Theme.ELearnLanguage" />

    <!-- Button with shadow style -->
    <style name="ChoiceButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/button_choice_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:hyphenationFrequency">normal</item>
        <item name="android:padding">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/lexend</item>
    </style>

    <style name="ChoiceButton.Wrong">
        <item name="android:background">@drawable/button_wrong_with_shadow</item>
    </style>

    <style name="ChoiceButton.Correct">
        <item name="android:background">@drawable/button_selected_with_shadow</item>
    </style>
</resources>