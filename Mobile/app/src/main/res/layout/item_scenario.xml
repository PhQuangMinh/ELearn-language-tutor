<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_scenario_item"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- User character icon -->
    <FrameLayout
        android:id="@+id/flPersonIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person_outline"
            android:contentDescription="Person" />
    </FrameLayout>

    <!-- User character section -->
    <TextView
        android:id="@+id/tvMyCharacterLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Nhân vật của bạn"
        android:fontFamily="@font/lexend"
        android:textColor="@color/neutral_60"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/flPersonIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/flPersonIcon" />

    <TextView
        android:id="@+id/tvMyCharacter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Nhân viên bán hàng"
        android:fontFamily="@font/lexend_semibold"
        android:textColor="@color/neutral_100"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/flPersonIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMyCharacterLabel" />

    <!-- Divider -->
    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_20"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMyCharacter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AI character icon -->
    <FrameLayout
        android:id="@+id/flBotIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_icon_circle_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bot"
            android:contentDescription="Bot" />
    </FrameLayout>

    <!-- AI character section -->
    <TextView
        android:id="@+id/tvAiCharacterLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Nhân vật AI"
        android:fontFamily="@font/lexend"
        android:textColor="@color/neutral_60"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/flBotIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/flBotIcon" />

    <TextView
        android:id="@+id/tvAiCharacter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Khách nước ngoài"
        android:fontFamily="@font/lexend_semibold"
        android:textColor="@color/neutral_100"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/flBotIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAiCharacterLabel" />

    <!-- Gender & Situation row -->
    <TextView
        android:id="@+id/tvGenderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Giới tính AI: "
        android:fontFamily="@font/lexend"
        android:textColor="@color/neutral_60"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flBotIcon" />

    <TextView
        android:id="@+id/tvGender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nam"
        android:fontFamily="@font/lexend_semibold"
        android:textColor="@color/primary_100"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/tvGenderLabel"
        app:layout_constraintTop_toBottomOf="@id/flBotIcon"
        app:layout_constraintBaseline_toBaselineOf="@id/tvGenderLabel" />

    <TextView
        android:id="@+id/tvSituation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tôi đang tư vấn khách hàng..."
        android:fontFamily="@font/lexend"
        android:textColor="@color/neutral_80"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGenderLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
