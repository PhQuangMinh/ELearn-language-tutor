<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.ui.main_app.vocabulary.FlashcardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/btnBack"
            layout="@layout/view_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/llModeSegment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_vocab_mode_segment_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack">

            <TextView
                android:id="@+id/tvModeVocab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_vocab_mode_segment_item_unselected"
                android:fontFamily="@font/lexend_semibold"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/label_mode_vocab"
                android:textColor="@color/neutral_100"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvModeFlashcard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_vocab_mode_segment_item_selected"
                android:fontFamily="@font/lexend_semibold"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/label_mode_flashcard"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierBelowModeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="btnBack,llModeSegment" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierBelowModeRow"
            tools:itemCount="5"
            tools:listitem="@layout/item_progress_segment" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text=""
        android:fontFamily="@font/lexend_semibold"
        android:textSize="34sp"
        android:textColor="@color/flashcard_title_tint"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpFLashcard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintHeight_percent="0.62"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintVertical_bias="0.1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrevious"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:icon="@drawable/baseline_chevron_left_24"
        app:iconGravity="textStart"
        app:iconSize="32dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:iconTint="@color/neutral_100"
        app:layout_constraintTop_toBottomOf="@id/vpFLashcard"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        app:icon="@drawable/baseline_chevron_left_24"
        android:rotation="180"
        app:iconGravity="textEnd"
        app:iconSize="32dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:iconTint="@color/neutral_100"
        app:layout_constraintTop_toTopOf="@id/btnPrevious"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>