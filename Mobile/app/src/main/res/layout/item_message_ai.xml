<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/ivBot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_bot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/aiMessageContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/ivBot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.62">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/speech_bubble_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvAiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend"
                android:lineSpacingExtra="2dp"
                android:text="AI message..."
                android:textColor="@color/neutral_100"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAiTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/lexend"
                android:lineSpacingExtra="2dp"
                android:text="Translation..."
                android:textColor="@color/neutral_80"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hint_button"
                android:fontFamily="@font/lexend_semibold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Gợi ý"
                android:textColor="@color/primary_100"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnTranslate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hint_button"
                android:fontFamily="@font/lexend_semibold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Dịch"
                android:textColor="@color/primary_100"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivSpeaker"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_circle_primary_80"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/volume_up_24px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hintPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hint_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHintAnalysis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend"
                android:text="Phân tích: ..."
                android:textColor="@color/neutral_100"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHintSuggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/lexend"
                android:text="Gợi ý: ..."
                android:textColor="@color/neutral_100"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHintExample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/lexend"
                android:text="Ví dụ: ..."
                android:textColor="@color/neutral_100"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

