<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/app_surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_gray"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface_card"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLessonImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardBackgroundColor="@color/neutral_20">

            <ImageView
                android:id="@+id/ivLessonImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/topic_image"
                android:scaleType="centerCrop"
                tools:src="@drawable/app_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/lexend_medium"
            android:textColor="@color/neutral_100"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@id/cardLessonImage"
            app:layout_constraintEnd_toStartOf="@id/cardArrow"
            app:layout_constraintStart_toEndOf="@id/cardLessonImage"
            app:layout_constraintTop_toTopOf="@id/cardLessonImage"
            tools:text="Grammar" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardBackgroundColor="@color/lesson_item_arrow_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_gray"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="@id/cardLessonImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardLessonImage">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/open"
                android:rotation="180"
                android:src="@drawable/baseline_chevron_left_24"
                app:tint="@color/topic_item_arrow_tint" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

