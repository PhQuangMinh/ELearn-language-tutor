<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:background="@color/white"
    tools:context=".presentation.ui.auth.register.EmailRegisterFragment">

    <include
        android:id="@+id/backButton"
        layout="@layout/view_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:id="@+id/tvEmailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_semibold"
            android:gravity="center"
            android:text="@string/set_up_your_new_password"
            android:textColor="@color/neutral_100"
            android:textSize="24sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_semibold"
            android:gravity="center"
            android:text="@string/new_password"
            android:textColor="@color/primary_100"
            android:textSize="16sp"
            android:layout_gravity="start"
            android:layout_marginTop="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:boxBackgroundColor="@android:color/white"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/input_stroke_blue"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:endIconMode="none"
            app:startIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start"
                android:hint="@string/enter_your_new_password_here"
                android:inputType="textEmailAddress"
                android:fontFamily="@font/lexend"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/neutral_100"
                android:textColorHint="@color/neutral_60" />

        </com.google.android.material.textfield.TextInputLayout>
        
        <TextView
            android:id="@+id/tvPasswordStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How strong your password: Weak"
            android:layout_gravity="start"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="15dp"
            android:textColor="@color/error_80"
            android:fontFamily="@font/lexend_light"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_semibold"
            android:gravity="center"
            android:text="@string/confirm_password"
            android:textColor="@color/primary_100"
            android:textSize="16sp"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordConfirmInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:boxBackgroundColor="@android:color/white"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/input_stroke_blue"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:endIconMode="none"
            app:startIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordConfirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start"
                android:hint="@string/enter_your_confirm_password_here"
                android:inputType="textEmailAddress"
                android:fontFamily="@font/lexend"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/neutral_100"
                android:textColorHint="@color/neutral_60" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lexend"
            android:textColor="@color/error_80"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/next"
            android:textSize="18sp"
            android:fontFamily="@font/lexend"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="28dp"
            app:elevation="0dp" />

        <ProgressBar
            android:id="@+id/pbResetPassword"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>