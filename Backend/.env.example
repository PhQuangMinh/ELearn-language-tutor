# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/btl_mobile?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_256_bits
JWT_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=604800000

# OAuth2 Google
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 Facebook
OAUTH2_FACEBOOK_APP_ID=your_facebook_app_id
OAUTH2_FACEBOOK_APP_SECRET=your_facebook_app_secret

# OAuth2 Mobile Redirect
OAUTH2_MOBILE_REDIRECT_URL=elearn://login/callback

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-latest
